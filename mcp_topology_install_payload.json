{
  "source_type": "remote",
  "source_ref": "netx-remote-mcp",
  "server_id": "netx-topology",
  "version": "0.4.19",
  "transport": "http",
  "url": "http://127.0.0.1:8890/mcp?groups=topology",
  "headers": {
    "Authorization": "Bearer ${NETX_API_TOKEN}"
  },
  "env_schema": {
    "NETX_API_TOKEN": {
      "type": "string",
      "description": "Bearer token (MCP token file or user JWT)"
    },
    "NETX_LANG": {
      "type": "string",
      "description": "Response language hint: zh or en",
      "default": "zh"
    }
  },
  "required_permissions": [],
  "risk_level": "medium",
  "enabled": true,
  "timeout_s": 120
}
