Value Filldown RD (\S+)
Value STATUS ((?:\*[<>isd]*(?:\s+[isd]+)?|[<>isd]+)?)
Value NETWORK (\d{1,3}(?:\.\d{1,3}){3}/\d{1,2}|[0-9A-Fa-f:]+/\d{1,3})
Value NEXT_HOP (\d{1,3}(?:\.\d{1,3}){3}|[0-9A-Fa-f:]+)
Value METRIC (\S*)
Value LOC_PRF (\S*)
Value TAG (\S*)
Value PATH (.*)

Start
  ^Routes\s+(Learned|Sent) -> Routes
  ^\s*\*?\s*Network\s+Next -> Routes
  ^Network\s+Next -> Routes
  ^\s*Dest\s+Next -> Routes
  # RD may appear before header on some snippets; keep Filldown ready
  ^Route\s+Distinguisher\s*:?\s*${RD}
  ^\s*$$
  ^.* -> Start

Routes
  ^Route\s+Distinguisher\s*:?\s*${RD}
  ^Status\s+codes
  ^Origin\s+codes
  ^Current\s+AS
  ^Total\s+number
  ^\s+Valid
  ^\s+Invalid
  ^Local\s+router
  ^Remote\s+router
  ^\s*\*?\s*Network\s+Next
  ^Network\s+Next
  ^\s*Dest\s+Next
  # One-line IPv4 / RR "* i  prefix nh …"
  ^\s*${STATUS}\s+${NETWORK}\s+${NEXT_HOP}\s+${METRIC}\s+${LOC_PRF}\s+${TAG}\s+${PATH}\s*$$ -> Record
  ^\s*${STATUS}\s+${NETWORK}\s+${NEXT_HOP}\s+${PATH}\s*$$ -> Record
  # IPv6 wrap: network alone, then next-hop (+ optional metric/path) lines
  ^\s*${STATUS}\s+${NETWORK}\s*$$
  ^\s+${NEXT_HOP}\s+${METRIC}\s+${LOC_PRF}\s+${TAG}\s+${PATH}\s*$$ -> Record
  ^\s+${NEXT_HOP}\s+${METRIC}\s+${LOC_PRF}\s+${PATH}\s*$$ -> Record
  ^\s+${NEXT_HOP}\s+${PATH}\s*$$ -> Record
  ^\s+${NEXT_HOP}\s*$$
  ^\s+${PATH}\s*$$ -> Record
  ^\s*$$
  ^\S+\s*#\s*$$ -> End
  ^.*#\s*$$ -> End
  ^.* -> Routes
