# ARCHIVE — not registered in index. bgp_route uses hand-only normalize
# (IN/OUT / status / From / RD+VRF / wraps diverge too much for one template).
Value Filldown RD (\S+)
Value Filldown VRF (\S+)
Value STATUS (\*(?:\s*[<>isd]+)?|[<>isd]+)
Value NETWORK (\d{1,3}(?:\.\d{1,3}){3}/\d{1,2}|[0-9A-Fa-f:]+/\d{1,3})
# IPv4, IPv6, or IPv4-mapped (::FFFF:a.b.c.d)
Value NEXT_HOP (\d{1,3}(?:\.\d{1,3}){3}|::[Ff]{4}:\d{1,3}(?:\.\d{1,3}){3}|[0-9A-Fa-f:]+)
Value FROM (\d{1,3}(?:\.\d{1,3}){3}|::[Ff]{4}:\d{1,3}(?:\.\d{1,3}){3}|[0-9A-Fa-f:]+)
Value METRIC (\S*)
Value LOC_PRF (\S*)
Value TAG (\S*)
Value PATH (.*)

Start
  ^Routes\s+(Learned|Sent) -> Routes
  ^\s*\*?\s*Network\s+Next -> Routes
  ^Network\s+Next -> Routes
  ^\s*Dest\s+Next -> Routes
  ^Route\s+Distinguisher\s*:?\s*${RD}(?:\s*\(\s*default\s+for\s+vrf\s+${VRF}\s*\))?
  ^\s*$$
  ^.* -> Start

Routes
  ^Route\s+Distinguisher\s*:?\s*${RD}(?:\s*\(\s*default\s+for\s+vrf\s+${VRF}\s*\))?
  ^Status\s+codes
  ^Origin\s+codes
  ^Current\s+AS
  ^Total\s+number
  ^\s+Valid
  ^\s+Invalid
  ^Local\s+router
  ^Remote\s+router
  ^\s*\*?\s*Network\s+Next
  ^Network\s+Next
  ^\s*Dest\s+Next
  # IN one-line with status: * i  prefix nh metric loc tag path
  ^\s*${STATUS}\s+${NETWORK}\s+${NEXT_HOP}\s+${METRIC}\s+${LOC_PRF}\s+${TAG}\s+${PATH}\s*$$ -> Record
  ^\s*${STATUS}\s+${NETWORK}\s+${NEXT_HOP}\s+${METRIC}\s+${LOC_PRF}\s+${PATH}\s*$$ -> Record
  ^\s*${STATUS}\s+${NETWORK}\s+${NEXT_HOP}\s+${PATH}\s*$$ -> Record
  # OUT one-line without status: net nh [from] metric locprf [tag] path
  ^\s*${NETWORK}\s+${NEXT_HOP}\s+${FROM}\s+${METRIC}\s+${LOC_PRF}\s+${TAG}\s+${PATH}\s*$$ -> Record
  ^\s*${NETWORK}\s+${NEXT_HOP}\s+${FROM}\s+${METRIC}\s+${LOC_PRF}\s+${PATH}\s*$$ -> Record
  ^\s*${NETWORK}\s+${NEXT_HOP}\s+${FROM}\s+${LOC_PRF}\s+${PATH}\s*$$ -> Record
  ^\s*${NETWORK}\s+${NEXT_HOP}\s+${LOC_PRF}\s+${PATH}\s*$$ -> Record
  # IN wrap: status+net+nh then indented metrics
  ^\s*${STATUS}\s+${NETWORK}\s+${NEXT_HOP}\s*$$
  ^\s+${METRIC}\s+${LOC_PRF}\s+${TAG}\s+${PATH}\s*$$ -> Record
  ^\s+${METRIC}\s+${LOC_PRF}\s+${PATH}\s*$$ -> Record
  ^\s+${PATH}\s*$$ -> Record
  # OUT wrap: net+nh+from then indented metrics (From may be long IPv6)
  ^\s*${NETWORK}\s+${NEXT_HOP}\s+${FROM}\s*$$
  ^\s+${METRIC}\s+${LOC_PRF}\s+${TAG}\s+${PATH}\s*$$ -> Record
  ^\s+${METRIC}\s+${LOC_PRF}\s+${PATH}\s*$$ -> Record
  ^\s+${PATH}\s*$$ -> Record
  # Classic wrap: network alone, then next-hop (+ optional metric/path)
  ^\s*${STATUS}\s+${NETWORK}\s*$$
  ^\s*${NETWORK}\s*$$
  ^\s+${NEXT_HOP}\s+${METRIC}\s+${LOC_PRF}\s+${TAG}\s+${PATH}\s*$$ -> Record
  ^\s+${NEXT_HOP}\s+${METRIC}\s+${LOC_PRF}\s+${PATH}\s*$$ -> Record
  ^\s+${NEXT_HOP}\s+${PATH}\s*$$ -> Record
  ^\s+${NEXT_HOP}\s*$$
  ^\s+${PATH}\s*$$ -> Record
  ^\s*$$
  ^\S+\s*#\s*$$ -> End
  ^.*#\s*$$ -> End
  ^.* -> Routes
