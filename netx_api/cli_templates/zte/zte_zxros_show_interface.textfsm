Value Filldown IFNAME (\S+)
Value Filldown ADMIN_STATE ((?:administratively\s+)?(?:up|down))
Value Filldown IFINDEX (\d+)
Value Filldown DESCRIPTION (.+?)
Value Filldown PORT_MEDIA (\S+)
Value Filldown NEGOTIATION (\S+)
Value Filldown BW_RAW (\d+(?:\.\d+)?\s*[kKmMgGtT]?\s*(?:G?bit|bit)/s(?:ec)?)
Value Filldown IP_MTU (\d+)
Value Filldown MTU (\d+)
Value Filldown MPLS_MTU (\d+)
Value Filldown IPV6_MTU (\d+)
Value Filldown RATE_PERIOD (\d+)
Value Filldown INPUT_BPS ([\d.]+)
Value Filldown OUTPUT_BPS ([\d.]+)
Value IN_UTIL ([\d.]+)
Value OUT_UTIL ([\d.]+)

Start
  ^${IFNAME}\s+is\s+${ADMIN_STATE}(?:,\s*ifindex:\s*${IFINDEX})? -> Continue.Clearall
  ^${IFNAME}\s+is\s+${ADMIN_STATE}(?:,\s*ifindex:\s*${IFINDEX})?
  ^\s*Description:\s*${DESCRIPTION}\s*$$
  ^\s*The\s+port\s+is\s+${PORT_MEDIA}
  ^\s*Negotiation\s+${NEGOTIATION}
  ^\s*BW\s+${BW_RAW}
  ^\s*IP\s+MTU\s+${IP_MTU}\s+bytes
  ^\s*IPv6\s+MTU\s+${IPV6_MTU}\s+bytes
  ^\s*MPLS\s+MTU\s+${MPLS_MTU}\s+bytes
  ^\s*MTU\s+${MTU}\s+bytes
  ^\s*Rate\s+period\s*:\s*${RATE_PERIOD}\s*s -> Rates
  ^\s*$$
  ^.* -> Start

Rates
  ^\s*Input\s*:\s*${INPUT_BPS}\s*bit/s
  ^\s*Output\s*:\s*${OUTPUT_BPS}\s*bit/s
  ^\s*Peak\s+rate: -> AfterPeak
  ^\s*Intf\s+utilization:\s*input\s*${IN_UTIL}%\s+output\s*${OUT_UTIL}% -> Record Start
  ^${IFNAME}\s+is\s+${ADMIN_STATE}(?:,\s*ifindex:\s*${IFINDEX})? -> Continue.Clearall
  ^${IFNAME}\s+is\s+${ADMIN_STATE}(?:,\s*ifindex:\s*${IFINDEX})? -> Start
  ^\s*$$
  ^.* -> Rates

AfterPeak
  ^\s*Intf\s+utilization:\s*input\s*${IN_UTIL}%\s+output\s*${OUT_UTIL}% -> Record Start
  ^${IFNAME}\s+is\s+${ADMIN_STATE}(?:,\s*ifindex:\s*${IFINDEX})? -> Continue.Clearall
  ^${IFNAME}\s+is\s+${ADMIN_STATE}(?:,\s*ifindex:\s*${IFINDEX})? -> Start
  ^\s*$$
  ^.* -> AfterPeak
