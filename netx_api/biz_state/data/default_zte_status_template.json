    {
      "sheet_id": "isis_adjacency.ipv4",
      "title": "ISIS IPv4",
      "metric_id": "isis_adjacency",
      "key_fields": [
        "process_id",
        "interface",
        "system_id"
      ],
      "iface_fields": [
        "interface"
      ],
      "compare_fields": [
        "state",
        "lev",
        "af"
      ],
      "display_fields": [
        "process_id",
        "interface",
        "system_id",
        "state",
        "lev",
        "af"
      ],
      "row_filters": [
        {
          "op": "contains",
          "field": "af",
          "value": "IPv4"
        }
      ],
      "field_rules": []
    },
    {
      "sheet_id": "isis_adjacency.ipv6",
