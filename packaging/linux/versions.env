# Pinned third-party inputs for the Linux release (sourced by build scripts).
# PostgreSQL major must match the Windows bundle (packaging/cache/pgsql-16.x).
PG_VERSION=16.4
PG_MAJOR=16
PG_URL=https://ftp.postgresql.org/pub/source/v16.4/postgresql-16.4.tar.bz2
PG_SHA256=971766d645aa73e93b9ef4e3be44201b4f45b5477095b049125403f9f3386d6f

# python-build-standalone: glibc 2.17 baseline on x86_64-unknown-linux-gnu.
PY_VERSION=3.12.7
PY_URL=https://github.com/astral-sh/python-build-standalone/releases/download/20241016/cpython-3.12.7+20241016-x86_64-unknown-linux-gnu-install_only_stripped.tar.gz
PY_SHA256=3a4d53a7ba3916c0c1f35cbbe57068e2571b138389f29cf5c35367fec8f4c617

# Build container: CentOS 7 userland => everything compiled or pip-installed
# links against glibc <= 2.17.
BUILD_IMAGE=quay.io/pypa/manylinux2014_x86_64
MAX_GLIBC=2.17
